# Copy to .env.local for local development. On Vercel, set these under
# Settings -> Environment Variables instead.

# Postgres. Use Supabase's *pooler* string -- port 6543, transaction mode.
# The direct connection (5432) will exhaust connections under serverless.
DATABASE_URL=postgres://uil:uil@localhost:55432/uil

# Optional. Connections per serverless instance; see connect() in src/lib/db.ts
# for why this is deliberately small.
# DATABASE_POOL_MAX=3
